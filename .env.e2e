# The build the E2E suite drives (`npm run build:e2e`, which Playwright's
# webServer runs before serving it).
#
# Suite J poses as the native app to sign in through the "system browser"
# (#358). The native app identifies itself with its own Client ID Document, and
# the Community Solid Server under test has to be able to fetch that document —
# so global-setup serves one on localhost, and this points the build at it.
VITE_NATIVE_CLIENT_ID_URL=http://localhost:4002/client-id-native.json
