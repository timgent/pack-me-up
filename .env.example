# Set to the hosted Client ID Document URL for static OIDC registration (production only).
# Leave unset for local dev and preview deploys — they fall back to dynamic client registration.
# VITE_CLIENT_ID_URL=https://packmeup.tim-gent.com/client-id.json

# The native app's own Client ID Document. The app defaults to the hosted
# public/client-id-native.json, so leave this unset for a store build; set it to
# point a natively-tested preview build at a copy of its own. VITE_CLIENT_ID_URL
# never applies to the native app — the website's document cannot list the
# native sign-in redirect (see docs/native-sign-in.md).
# VITE_NATIVE_CLIENT_ID_URL=https://preview.example.com/client-id-native.json

# The app's public web address, used for anything that leaves the device —
# share links, invite links, QR codes. Defaults to the origin of the hosted
# Client ID Document above, which is what production and the native app want.
# Set it only for a staging deploy that should hand out links to itself.
# VITE_PUBLIC_ORIGIN=https://staging.packmeup.example.com

# Sentry error reporting is off in local dev (errors go to the console instead).
# Set this to true to send local dev errors to Sentry, e.g. when verifying a Sentry change.
# VITE_SENTRY_ENABLED=true
